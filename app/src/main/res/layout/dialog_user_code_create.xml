<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/user_code_class_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_class_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/user_code_template"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/rg_template"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_empty_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_code_template_class" />

        <RadioButton
            android:id="@+id/rb_utils"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_code_template_utils" />

        <RadioButton
            android:id="@+id/rb_custom_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_code_template_view" />

        <RadioButton
            android:id="@+id/rb_interface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_code_template_interface" />

    </RadioGroup>

</LinearLayout>
