<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="built-in-blocks"
        app:summary="@string/settings_builtin_blocks_summary"
        app:title="@string/settings_builtin_blocks_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="always-show-blocks"
        app:summary="@string/settings_show_all_var_summary"
        app:title="@string/settings_show_all_var_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="show-every-single-block"
        app:summary="@string/settings_show_all_blocks_summary"
        app:title="@string/settings_show_all_blocks_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="block-dependency-hints"
        app:defaultValue="true"
        app:summary="@string/block_dep_hints_summary"
        app:title="@string/block_dep_hints_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="live-search-enabled"
        app:defaultValue="false"
        app:summary="@string/settings_live_search_summary"
        app:title="@string/settings_live_search_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="logic-editor-gpu"
        app:defaultValue="false"
        app:summary="@string/settings_logic_editor_gpu_summary"
        app:title="@string/settings_logic_editor_gpu_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="quick-props-panel"
        app:defaultValue="false"
        app:summary="@string/settings_quick_props_panel_summary"
        app:title="@string/settings_quick_props_panel_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="show-headers-when-searching-blocks"
        app:summary="@string/settings_search_headers_summary"
        app:title="@string/settings_search_headers_title" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="backup-dir"
        app:summary="@string/settings_backup_dir_summary"
        app:title="@string/common_word_backup_directory" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="root-auto-install-projects"
        app:summary="@string/settings_root_install_summary"
        app:title="@string/settings_root_install_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="root-auto-open-after-installing"
        app:summary="@string/settings_root_open_summary"
        app:title="@string/settings_root_open_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="use-new-version-control"
        app:summary="@string/settings_new_version_control_summary"
        app:title="@string/settings_new_version_control_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="use-asd-highlighter"
        app:summary="@string/settings_asd_highlighter_summary"
        app:title="@string/settings_asd_highlighter_title" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="backup-filename"
        app:summary="@string/settings_backup_filename_summary"
        app:title="@string/settings_backup_filename_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="block-logic-check"
        app:summary="@string/settings_block_logic_check_summary"
        app:title="@string/settings_block_logic_check_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="block-logic-check-before-build"
        app:summary="@string/settings_block_logic_before_build_summary"
        app:title="@string/settings_block_logic_before_build_title" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        app:key="block-templates"
        app:summary="@string/settings_block_templates_summary"
        app:title="@string/settings_block_templates_title" />
    <PreferenceCategory app:title="@string/settings_category_skproj_export">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-components"
            app:defaultValue="true"
            app:summary="@string/settings_skproj_components_summary"
            app:title="@string/settings_skproj_components_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-variables"
            app:defaultValue="true"
            app:summary="@string/settings_skproj_vars_summary"
            app:title="@string/settings_skproj_vars_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-resources"
            app:defaultValue="true"
            app:summary="@string/settings_skproj_resources_summary"
            app:title="@string/settings_skproj_resources_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-custom-blocks"
            app:defaultValue="true"
            app:summary="@string/settings_skproj_custom_blocks_summary"
            app:title="@string/settings_skproj_custom_blocks_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-local-libs"
            app:defaultValue="false"
            app:summary="@string/settings_skproj_local_libs_summary"
            app:title="@string/settings_skproj_local_libs_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-include-apk"
            app:defaultValue="false"
            app:summary="@string/settings_skproj_apk_summary"
            app:title="@string/settings_skproj_apk_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="skproj-format-zip"
            app:defaultValue="true"
            app:summary="@string/settings_skproj_zip_summary"
            app:title="@string/settings_skproj_zip_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="skproj-output-dir"
            app:summary="@string/settings_skproj_output_dir_summary"
            app:title="@string/settings_skproj_output_dir_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_auto_backup">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="auto-backup-enabled"
            app:summary="@string/settings_auto_backup_after_build_summary"
            app:title="@string/settings_auto_backup_after_build_title" />
        <ListPreference
            app:iconSpaceReserved="false"
            app:key="auto-backup-keep-count"
            app:defaultValue="5"
            app:entries="@array/auto_backup_keep_entries"
            app:entryValues="@array/auto_backup_keep_values"
            app:summary="@string/settings_auto_backup_keep_summary"
            app:title="@string/settings_auto_backup_keep_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_backup_settings">
        <Preference
            app:iconSpaceReserved="false"
            app:key="export-app-settings"
            app:summary="@string/settings_export_settings_summary"
            app:title="@string/settings_export_settings_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="import-app-settings"
            app:summary="@string/settings_import_settings_summary"
            app:title="@string/settings_import_settings_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_debug">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="debug-log-enabled"
            app:summary="@string/settings_debug_log_summary"
            app:title="@string/settings_debug_log_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="debug-log-verbose"
            app:summary="@string/settings_debug_log_verbose_summary"
            app:title="@string/settings_debug_log_verbose_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="debug-log-open"
            app:summary="@string/settings_debug_log_open_summary"
            app:title="@string/settings_debug_log_open" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_smartdrop">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:key="smartdrop-update-all-blocks"
            app:summary="@string/settings_smartdrop_update_all_summary"
            app:title="@string/settings_smartdrop_update_all_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:key="smartdrop-force-replace"
            app:summary="@string/settings_smartdrop_force_replace_summary"
            app:title="@string/settings_smartdrop_force_replace_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="smartdrop-update-all-now"
            app:summary="@string/settings_smartdrop_manual_update_summary"
            app:title="@string/settings_smartdrop_manual_update_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/updates_settings_title">
        <Preference
            app:iconSpaceReserved="false"
            app:key="updates-check-now"
            app:summary="@string/updates_check_now_summary"
            app:title="@string/updates_check_now" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_help">
        <Preference
            app:iconSpaceReserved="false"
            app:key="open-help"
            app:summary="@string/settings_help_open_summary"
            app:title="@string/settings_help_open_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_icons_category">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:key="icons-show-enabled"
            app:summary="@string/settings_icons_show_summary"
            app:title="@string/settings_icons_show_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="false"
            app:key="icons-mixed-search"
            app:summary="@string/settings_icons_mixed_summary"
            app:title="@string/settings_icons_mixed_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_category_palette">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="false"
            app:key="remember-palette-position"
            app:summary="@string/settings_remember_palette_position_summary"
            app:title="@string/settings_remember_palette_position_title" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="false"
            app:key="save-on-property-change"
            app:summary="@string/settings_save_on_property_change_summary"
            app:title="@string/settings_save_on_property_change_title" />
    </PreferenceCategory>
</PreferenceScreen>